# Miden node RPC endpoint.
MIDEN_RPC_URL=https://rpc.testnet.miden.io

# Registry account id (hex or bech32). Required.
MIDEN_XYC_REGISTRY_ID=

# HTTP listen address.
INDEXER_LISTEN=0.0.0.0:8080

# Poll intervals, in seconds.
POOL_POLL_SECS=15
REGISTRY_POLL_SECS=60

# Tracing filter.
RUST_LOG=miden_xyk_indexer=info

# SQLite database path. History is replayed from it on start and written back
# after every poll. Empty or "off" keeps the index in RAM only, which forgets
# every series, activity, and yield window on restart.
INDEXER_DB=miden_xyk_indexer.sqlite

# Snapshot retention. Empty prunes each resolution to its RAM window (6 h of
# minutes, 48 h of five-minutes, 30 days of hours). "all" keeps every bucket
# forever, which is the policy the storage arithmetic in the README prices.
INDEXER_SNAPSHOT_RETENTION=
