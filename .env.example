# Node RPC endpoint.
MIDEN_RPC_URL=https://rpc.testnet.miden.io

# Registry account id, hex. Required.
PORT0_REGISTRY_ID=

# Listen address. Loopback keeps the API behind a reverse proxy.
INDEXER_LISTEN=127.0.0.1:8080

# Origins allowed to read the API cross-origin, comma separated. Empty allows
# same-origin only; a hosted deployment must list the app's origin.
INDEXER_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180

# Poll intervals, in seconds. The pool value is clamped to 1..=5; per-pool
# cadence comes from the index's tiers.
POOL_POLL_SECS=5
REGISTRY_POLL_SECS=60

# SQLite path. Empty or "off" keeps the index in memory only.
INDEXER_DB=port0_indexer.sqlite

# "all" keeps every snapshot bucket; empty prunes each tier to its own window.
INDEXER_SNAPSHOT_RETENTION=

# Tracing filter.
RUST_LOG=port0_indexer=info
